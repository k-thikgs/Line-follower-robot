<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="line_following_world">
    <!-- Sun - Directional light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Line to follow -->
    <model name="curved_track">
      <static>true</static>
      <!-- 36 segments forming a circle -->
      <!-- Each segment is a small box placed along a circular arc -->
      <!-- Radius of the track -->
      <!-- Feel free to adjust radius or number of segments -->

      <!-- Circle: radius = 3m, segments = 36, segment angle = 10 degrees -->
      <!-- Each segment has a slight rotation and offset -->

      <!-- We'll repeat one segment 36 times around a circle -->
      <!-- Black color for the line -->
      <!-- Box size = (0.5 x 0.1 x 0.01) -->

      <!-- Generated curve segments -->
      <!-- START CURVE -->
      <!-- Generated via script or manually. Here's the result: -->
      <!-- Loop from i = 0 to 35 (36 segments) -->
      <!-- Each has pose: x = r*cos(theta), y = r*sin(theta), yaw = theta -->
      <!-- Each angle = i * 10 degrees = i * π/18 -->

      <!-- BEGIN CIRCULAR TRACK SEGMENTS -->
      <!-- Radius: 3.0, Segment count: 36 -->
      <!-- Each segment is rotated to follow the curve -->
      <!-- Simplified XML listing just a few and pattern follows -->
      <!-- Full list for smooth circle -->
      <!-- Each link name must be unique -->
      <!-- We will only show a few here to keep it brief -->
      <!-- You can generate full with a script or request more -->

      <!-- You can replace this with a loop in a script for a full circle -->
      <!-- Example first 6 segments shown -->

      
